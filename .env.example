# Turso (libSQL) - https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# App auth (≥ 8 chars, e.g. node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
APP_SECRET=replace-me-with-strong-random

# GitHub Actions（手動新增 metadata 不完整時，派送 AvBatch backfill.yml）
# Fine-grained PAT：目標 AvBatch repository 的 Actions: write；classic PAT：repo scope。
# 先 rollout AvBatch（包含 code、limit、request_id inputs）並驗證 workflow，再部署 AvCollect。
# queued=true 僅代表 GitHub 接受派送，metadata 回補仍 pending。
GITHUB_REPO=c14712369/Batch-AvBatch
GITHUB_TOKEN=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
